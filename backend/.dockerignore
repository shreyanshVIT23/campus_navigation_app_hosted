# Patterns are anchored at the build context root; **/ makes them match at any depth.

# Secrets: the container gets its environment from compose env_file
**/.env
**/.env.*
**/.envrc

# Byte-compiled files
**/__pycache__/
**/*.py[cod]

# Virtual environments and tool caches
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.ruff_cache/
**/.coverage

# Git, Docker and editor files
**/.git
**/.gitignore
**/.gitattributes
Dockerfile
**/docker-compose*.yml
**/.vscode/
**/.idea/
**/.DS_Store
**/.claude/

# Docs and logs
**/*.md
docs/
**/*.log
**/*_log.txt
server/logs/

# Tests and dev-only files
server/Test/
requirements.txt*
**/*.bak
**/*.swp
**/*.tmp

# Databases: only the ones the app runs on (backups and old copies stay out)
server/DB/*
!server/DB/ab01-01.db
!server/DB/lab.db
!server/DB/chatbot2.db
!server/DB/event1.db
!server/DB/user_auth.db

# Recorded audio is per-request scratch
server/Chatbot/temp_audio/*
